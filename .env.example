# ==============================================================================
# PROJECT TITAN — Environment Configuration Template
# Copy this file to .env before starting development: cp .env.example .env
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# ==============================================================================

# Application Environment
NODE_ENV=development
LOG_LEVEL=info

# Service Ports
GATEWAY_PORT=8080
API_PORT=8000
WS_PORT=8081
FRONTEND_PORT=3000

# PostgreSQL 16+ Database Configuration
DATABASE_URL=postgresql://titan_admin:titan_secure_password_123@localhost:5432/titan_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=titan_db
DB_USER=titan_admin
DB_PASSWORD=titan_secure_password_123
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis 7.2 Configuration (Streams, Cache, Pub/Sub)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cryptographic & Security Keys
# GENERATE NEW RANDOM SECRETS FOR PRODUCTION (e.g. openssl rand -hex 32)
JWT_SECRET=titan_development_jwt_secret_must_be_at_least_32_bytes_long!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY_HEX=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Webhook Ingestion Security
WEBHOOK_HMAC_SECRET=titan_webhook_default_hmac_secret_key_change_me
WEBHOOK_RATE_LIMIT_BURST=1000
WEBHOOK_RATE_LIMIT_RATE=500

# CORS & Public Endpoints
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8081
